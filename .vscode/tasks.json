{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "DJANGO_SETTINGS_MODULE": "SENNOVA.local_settings",
      "PYTHONUTF8": "1"
    }
  },
  "tasks": [
    {
      "label": "GESICOM: preparar .venv",
      "type": "process",
      "command": "python3.15",
      "args": [
        "scripts/configurar_entorno.py",
        "--inicio-rapido",
        "--extensiones",
        "--reparar-entorno"
      ],
      "windows": {
        "command": "python",
        "args": [
          "scripts/configurar_entorno.py",
          "--inicio-rapido",
          "--extensiones",
          "--reparar-entorno"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "GESICOM: comprobar Django",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "manage.py",
        "check"
      ],
      "group": "build",
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    },
    {
      "label": "GESICOM: aplicar migraciones",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "manage.py",
        "migrate",
        "--noinput"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    },
    {
      "label": "GESICOM: recopilar estáticos",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "manage.py",
        "collectstatic",
        "--noinput"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    },
    {
      "label": "GESICOM: pruebas de Django",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "manage.py",
        "test",
        "--settings=SENNOVA.test_settings",
        "--noinput"
      ],
      "group": "test",
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "options": {
        "env": {
          "DJANGO_SETTINGS_MODULE": "SENNOVA.test_settings",
          "DB_ENGINE": "sqlite",
          "REDIS_URL": "",
          "DJANGO_DEBUG": "True",
          "DJANGO_SECRET_KEY": "clave-exclusiva-de-pruebas-locales-no-usar-en-produccion"
        }
      }
    },
    {
      "label": "GESICOM: revisar código",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "ruff",
        "check",
        "."
      ],
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      }
    }
  ]
}
